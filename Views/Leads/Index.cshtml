@model AI_Powered_CRM.ViewModels.LeadIndexViewModel
@{
    ViewData["Title"] = "Leads Workspace";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Leads Intelligence Workspace</h3>
        <p class="text-muted small mb-0">
            View, search, and prioritize leads with AI-driven scoring and qualification insights.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm px-3">
            <i class="bi bi-person-plus-fill"></i> Add New Lead
        </a>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-lg-4 col-md-6">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.Search" class="form-control bg-light border-start-0" placeholder="Search by name, phone, company, product..." />
            </div>
        </div>

        <div class="col-lg-2 col-md-3 col-sm-6">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Pipeline Stages</option>
                @foreach (var s in Enum.GetValues<LeadStatus>())
                {
                    <option value="@s" selected="@(Model.Status == s ? "selected" : null)">@s</option>
                }
            </select>
        </div>

        <div class="col-lg-2 col-md-3 col-sm-6">
            <select name="priority" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Priorities</option>
                @foreach (var p in Enum.GetValues<LeadPriority>())
                {
                    <option value="@p" selected="@(Model.Priority == p ? "selected" : null)">@p Priority</option>
                }
            </select>
        </div>

        <div class="col-lg-2 col-md-6 col-sm-6">
            <select name="source" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Sources</option>
                <option value="Website" selected="@(Model.Source == "Website" ? "selected" : null)">Website</option>
                <option value="Instagram" selected="@(Model.Source == "Instagram" ? "selected" : null)">Instagram</option>
                <option value="Referral" selected="@(Model.Source == "Referral" ? "selected" : null)">Referral</option>
                <option value="LinkedIn" selected="@(Model.Source == "LinkedIn" ? "selected" : null)">LinkedIn</option>
                <option value="ColdCall" selected="@(Model.Source == "ColdCall" ? "selected" : null)">Cold Call</option>
                <option value="EmailCampaign" selected="@(Model.Source == "EmailCampaign" ? "selected" : null)">Email Campaign</option>
            </select>
        </div>

        <div class="col-lg-2 col-md-6 col-sm-6 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-dark w-100">Filter</button>
            @if (!string.IsNullOrEmpty(Model.Search) || Model.Status.HasValue || Model.Priority.HasValue || !string.IsNullOrEmpty(Model.Source))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </form>
</div>

<!-- Leads Data Table -->
<div class="crm-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light text-muted text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                <tr>
                    <th class="ps-4">Lead Name / Company</th>
                    <th>Contact</th>
                    <th>Product / Budget</th>
                    <th>Pipeline Stage</th>
                    <th>AI Priority & Score</th>
                    <th>Owner</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Leads.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 text-secondary mb-2 d-block"></i>
                            <div class="fw-semibold">No leads found matching your criteria.</div>
                            <small>Try clearing your filters or create a new lead to get started.</small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var lead in Model.Leads)
                    {
                        var latestAi = lead.AIInsights.OrderByDescending(i => i.GeneratedAt).FirstOrDefault();
                        var aiScore = latestAi?.Score ?? 0;
                        var aiClass = latestAi?.Classification.ToString() ?? "Warm";

                        <tr>
                            <td class="ps-4">
                                <a asp-action="Details" asp-route-id="@lead.LeadId" class="fw-bold text-dark text-decoration-none d-block">
                                    @lead.Name
                                </a>
                                <small class="text-muted">@(lead.Company ?? "Individual Client")</small>
                            </td>
                            <td>
                                <div><i class="bi bi-telephone text-muted me-1"></i>@lead.Phone</div>
                                @if (!string.IsNullOrEmpty(lead.Email))
                                {
                                    <small class="text-muted"><i class="bi bi-envelope text-muted me-1"></i>@lead.Email</small>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-truncate" style="max-width: 180px;">@lead.InterestedProduct</div>
                                <small class="text-success fw-semibold">
                                    @(lead.Budget.HasValue ? "$" + lead.Budget.Value.ToString("N0") : "Budget Unset")
                                </small>
                            </td>
                            <td>
                                <span class="badge-stage">
                                    @lead.Status
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @(aiClass == "Hot" ? "badge-hot" : (aiClass == "Warm" ? "badge-warm" : "badge-cold"))">
                                        @aiClass
                                    </span>
                                    <div class="d-flex align-items-center gap-1" title="AI Score: @aiScore/100">
                                        <div class="progress" style="width: 50px; height: 6px;">
                                            <div class="progress-bar @(aiScore >= 75 ? "bg-danger" : (aiScore >= 40 ? "bg-warning" : "bg-primary"))" 
                                                 role="progressbar" style="width: @aiScore%"></div>
                                        </div>
                                        <span class="fw-bold small" style="font-size: 0.75rem;">@aiScore</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-person-circle text-secondary"></i>
                                    <span class="small">@(lead.OwnerUser?.FullName ?? lead.OwnerUser?.UserName ?? "Unassigned")</span>
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@lead.LeadId" class="btn btn-outline-primary" title="Open Lead Intelligence Workspace">
                                        <i class="bi bi-stars me-1"></i> Workspace
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@lead.LeadId" class="btn btn-outline-secondary" title="Edit Lead">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (@Model.TotalCount total leads)</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" 
                           asp-route-search="@Model.Search" asp-route-status="@Model.Status" 
                           asp-route-priority="@Model.Priority" asp-route-source="@Model.Source">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" 
                               asp-route-search="@Model.Search" asp-route-status="@Model.Status" 
                               asp-route-priority="@Model.Priority" asp-route-source="@Model.Source">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" 
                           asp-route-search="@Model.Search" asp-route-status="@Model.Status" 
                           asp-route-priority="@Model.Priority" asp-route-source="@Model.Source">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
