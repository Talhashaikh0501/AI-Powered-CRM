@model AI_Powered_CRM.ViewModels.LeadCreateEditViewModel
@{
    ViewData["Title"] = "Create Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold text-dark mb-0">Create New Lead</h4>
                <small class="text-muted">Enter prospect profile details to initiate AI analysis and tracking</small>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Leads
            </a>
        </div>

        <div class="crm-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <!-- Name -->
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Prospect Full Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Ahmed Khan" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Company -->
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Company / Organization</label>
                        <input asp-for="Company" class="form-control" placeholder="e.g. AK Traders Pvt Ltd" />
                        <span asp-validation-for="Company" class="text-danger small"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Primary Phone Number <span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control" placeholder="+91-9876543210" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="client@company.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Interested Product -->
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Interested Product / Service <span class="text-danger">*</span></label>
                        <input asp-for="InterestedProduct" class="form-control" placeholder="e.g. Custom ERP System" required />
                        <span asp-validation-for="InterestedProduct" class="text-danger small"></span>
                    </div>

                    <!-- Budget -->
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Estimated Budget ($)</label>
                        <input asp-for="Budget" type="number" step="1000" class="form-control" placeholder="e.g. 50000" />
                        <span asp-validation-for="Budget" class="text-danger small"></span>
                    </div>

                    <!-- Source -->
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary">Lead Source <span class="text-danger">*</span></label>
                        <select asp-for="Source" class="form-select">
                            <option value="Website">Website Form</option>
                            <option value="Instagram">Instagram Ad</option>
                            <option value="LinkedIn">LinkedIn Outreach</option>
                            <option value="Referral">Client Referral</option>
                            <option value="ColdCall">Cold Call</option>
                            <option value="EmailCampaign">Email Campaign</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <!-- Priority -->
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary">Manual Priority</label>
                        <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<LeadPriority>()"></select>
                    </div>

                    <!-- Owner (Admin/Manager can assign) -->
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary">Assign Owner</label>
                        <select asp-for="OwnerUserId" class="form-select">
                            @foreach (var user in Model.AvailableUsers)
                            {
                                <option value="@user.Id">@(user.FullName ?? user.UserName)</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="border-top mt-4 pt-3 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Save & Run AI Analysis
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
