@model AI_Powered_CRM.ViewModels.AdminInvitationsViewModel
@using AI_Powered_CRM.Models.Enums
@{
    ViewData["Title"] = "Employee Invitations";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Employee Invitations</h3>
        <p class="text-muted small mb-0">
            Invite colleagues to your workspace, assign company roles, and monitor invitation status.
        </p>
    </div>
    <div>
        <a asp-action="Users" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-people me-1"></i> Active Users
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["InviteUrl"] != null)
{
    <div class="card border-primary border-opacity-50 shadow-sm mb-4 bg-light">
        <div class="card-body p-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-send-check text-primary fs-5"></i>
                <h6 class="fw-bold mb-0 text-primary">Invitation Link Generated</h6>
            </div>
            <p class="small text-muted mb-2">Share this secure link with the invited employee to complete onboarding:</p>
            <div class="input-group">
                <input type="text" class="form-control form-control-sm font-monospace bg-white" id="generatedInviteUrl" value="@TempData["InviteUrl"]" readonly />
                <button class="btn btn-primary btn-sm" type="button" onclick="navigator.clipboard.writeText(document.getElementById('generatedInviteUrl').value); alert('Invitation URL copied to clipboard!');">
                    <i class="bi bi-clipboard me-1"></i> Copy Link
                </button>
            </div>
        </div>
    </div>
}

<!-- Quota & Send Invite Card -->
<div class="row g-4 mb-4">
    <!-- Seat Quota Card -->
    <div class="col-lg-4">
        <div class="crm-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">Team Seats Usage</h6>
                <span class="badge @(Model.CanInviteMore ? "bg-success" : "bg-danger")">
                    @(Model.CanInviteMore ? "Seats Available" : "Quota Reached")
                </span>
            </div>
            <div class="d-flex align-items-baseline gap-2 mb-2">
                <h2 class="fw-bold mb-0 text-dark">@Model.ActiveUserSeats</h2>
                <span class="text-muted fs-6">/ @Model.MaxUserSeats seats utilized</span>
            </div>
            @{
                var seatPercent = Model.MaxUserSeats > 0 ? (int)((double)Model.ActiveUserSeats / Model.MaxUserSeats * 100) : 100;
            }
            <div class="progress mb-3" style="height: 8px;">
                <div class="progress-bar @(seatPercent >= 100 ? "bg-danger" : (seatPercent >= 80 ? "bg-warning" : "bg-primary"))"
                     role="progressbar" style="width: @seatPercent%;" aria-valuenow="@seatPercent" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <p class="small text-muted mb-0">
                Each active employee membership consumes 1 seat. Plan limit is @Model.MaxUserSeats seats.
            </p>
        </div>
    </div>

    <!-- Send Invite Form -->
    <div class="col-lg-8">
        <div class="crm-card p-4 h-100">
            <h6 class="fw-bold text-dark mb-3">Invite Team Member</h6>
            @if (Model.CanInviteMore)
            {
                <form asp-action="InviteUser" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold text-secondary">Work Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="NewInvite.Email" class="form-control border-start-0" placeholder="colleague@company.com" required />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-secondary">Role</label>
                            <select asp-for="NewInvite.CompanyRole" class="form-select" asp-items="Html.GetEnumSelectList<CompanyRole>()">
                            </select>
                        </div>
                    </div>
                    <div class="mt-3 text-end">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-send-fill me-1"></i> Send Invitation
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-warning py-2 small mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> You have reached your active seat limit (@Model.MaxUserSeats). Upgrade subscription or disable an inactive user to invite new members.
                </div>
            }
        </div>
    </div>
</div>

<!-- Invitations History Table -->
<div class="crm-card overflow-hidden">
    <div class="p-3 border-bottom bg-light d-flex justify-content-between align-items-center">
        <h6 class="fw-bold text-dark mb-0">Invitation History (@Model.Invitations.Count)</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light text-muted text-uppercase" style="font-size: 0.72rem;">
                <tr>
                    <th class="ps-4">Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Invited By</th>
                    <th>Sent At</th>
                    <th>Expires At</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Invitations.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted small">
                            No invitations sent yet. Invite your first team member above!
                        </td>
                    </tr>
                }
                @foreach (var invite in Model.Invitations)
                {
                    <tr>
                        <td class="ps-4 fw-semibold text-dark">@invite.Email</td>
                        <td>
                            <span class="badge @(invite.CompanyRole == CompanyRole.CompanyAdmin ? "bg-danger" : (invite.CompanyRole == CompanyRole.Manager ? "bg-warning text-dark" : "bg-primary"))">
                                @invite.CompanyRole
                            </span>
                        </td>
                        <td>
                            @if (invite.IsAccepted)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Accepted</span>
                            }
                            else if (invite.IsExpired)
                            {
                                <span class="badge bg-secondary"><i class="bi bi-clock-history me-1"></i> Expired</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark"><i class="bi bi-hourglass-split me-1"></i> Pending</span>
                            }
                        </td>
                        <td class="small text-muted">@invite.InvitedByUserName</td>
                        <td class="small text-muted">@invite.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                        <td class="small text-muted">@invite.ExpiresAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end pe-4">
                            @if (!invite.IsAccepted)
                            {
                                <form asp-action="RevokeInvitation" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to revoke this invitation?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="invitationId" value="@invite.InvitationId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.78rem;">
                                        <i class="bi bi-x-circle me-1"></i> Revoke
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
