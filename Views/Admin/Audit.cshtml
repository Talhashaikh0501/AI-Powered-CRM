@model List<AI_Powered_CRM.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "Security Audit Logs";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Security & Operational Audit Logs</h3>
        <p class="text-muted small mb-0">
            Immutable chronological audit record of sensitive data transitions, assignments, and status shifts.
        </p>
    </div>
</div>

<div class="crm-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
            <thead class="table-light text-muted text-uppercase" style="font-size: 0.72rem;">
                <tr>
                    <th class="ps-4">Timestamp (UTC)</th>
                    <th>User / Actor</th>
                    <th>Entity Type</th>
                    <th>Entity ID</th>
                    <th>Action</th>
                    <th class="pe-4">Metadata Details</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No audit events logged yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="ps-4 font-monospace text-muted" style="font-size: 0.78rem;">
                                @log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-person text-secondary"></i>
                                    <span class="fw-semibold">@(log.User?.FullName ?? log.User?.UserName ?? "System")</span>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@log.EntityType</span></td>
                            <td class="font-monospace text-muted">#@log.EntityId</td>
                            <td>
                                <span class="badge @(log.Action == "Created" ? "bg-success" : (log.Action == "Deleted" || log.Action == "Archived" ? "bg-danger" : "bg-primary"))">
                                    @log.Action
                                </span>
                            </td>
                            <td class="pe-4 font-monospace text-muted text-truncate" style="max-width: 320px; font-size: 0.75rem;" title="@log.DetailsJson">
                                @log.DetailsJson
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
