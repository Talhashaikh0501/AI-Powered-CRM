@{
    ViewData["Title"] = "Confirm Your Email";
    Layout = "_Layout";
    var email = ViewBag.Email as string;
    var emailSent = ViewBag.EmailSent as bool? ?? true;
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5 px-3">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 text-center" style="max-width: 540px; width: 100%;">
        <div class="mb-4">
            <div class="rounded-circle @(emailSent ? "bg-primary bg-opacity-10 text-primary" : "bg-warning bg-opacity-10 text-warning") d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 72px; height: 72px;">
                <i class="bi @(emailSent ? "bi-envelope-paper-heart" : "bi-exclamation-triangle") fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">@(emailSent ? "Check your email" : "Registration Pending Verification")</h3>
            <p class="text-muted small">
                @if (emailSent)
                {
                    <span>We've dispatched a verification link to</span>
                }
                else
                {
                    <span>Your company was registered, but automatic email delivery could not be confirmed for</span>
                }
                @if (!string.IsNullOrEmpty(email))
                {
                    <strong class="text-dark">@email</strong>
                }
                else
                {
                    <span>your registered work email address</span>
                }
                .
            </p>
        </div>

        @if (!emailSent)
        {
            <div class="alert alert-warning border small text-start mb-4">
                <div class="fw-semibold text-dark mb-1"><i class="bi bi-exclamation-circle me-1 text-warning"></i> Mail Server Notice:</div>
                <p class="mb-0">Outbound SMTP delivery was unsuccessful or unconfigured. Please ensure your mail settings are active, or click below to request a new verification link.</p>
            </div>
        }

        <div class="alert alert-light border small text-secondary text-start mb-4">
            <div class="fw-semibold text-dark mb-1"><i class="bi bi-info-circle me-1 text-primary"></i> Next steps:</div>
            <ol class="ps-3 mb-0">
                <li>Open the email from <strong>AI-Powered CRM</strong>.</li>
                <li>Click the <strong>Verify Email Address</strong> button to activate your account.</li>
                <li>Sign in to access your newly created workspace.</li>
            </ol>
        </div>

        <div class="d-flex flex-column gap-2">
            <a asp-action="Login" class="btn btn-primary py-2 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-1"></i> Return to Sign In
            </a>
            <a asp-action="ResendEmailConfirmation" asp-route-email="@email" class="btn btn-outline-secondary py-2 small">
                <i class="bi bi-arrow-repeat me-1"></i> Didn't receive an email? Resend link
            </a>
        </div>
    </div>
</div>
