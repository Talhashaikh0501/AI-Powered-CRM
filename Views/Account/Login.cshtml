@model AI_Powered_CRM.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5 px-3">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="max-width: 950px; width: 100%;">
        <div class="row g-0">
            <!-- Left Brand Banner -->
            <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-between p-5 text-white" 
                 style="background: linear-gradient(145deg, #0f172a 0%, #1e3a8a 100%);">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <div class="rounded-3 bg-primary p-2 text-white d-flex align-items-center justify-content-center shadow" style="width: 42px; height: 42px;">
                            <i class="bi bi-cpu-fill fs-4"></i>
                        </div>
                        <h4 class="fw-bold mb-0 text-white">NexusCRM <span class="badge bg-primary text-white fs-6">AI</span></h4>
                    </div>

                    <h2 class="fw-bold mb-3">Enterprise Sales Intelligence Platform</h2>
                    <p class="text-light text-opacity-75 lead fs-6">
                        Automate lead prioritization, detect conversion risks, and guide reps with real-time AI scoring and next best action suggestions.
                    </p>
                </div>

                <div class="pt-4 border-top border-white border-opacity-10">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-3 rounded-3 bg-white bg-opacity-10">
                                <div class="fw-bold fs-5 text-white">100%</div>
                                <div class="small text-light text-opacity-75">Zero Cost AI & SQL</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3 bg-white bg-opacity-10">
                                <div class="fw-bold fs-5 text-white">3 Roles</div>
                                <div class="small text-light text-opacity-75">Admin, Manager, Rep</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Login Form -->
            <div class="col-lg-6 p-4 p-sm-5 bg-white">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark mb-1">Welcome back</h3>
                    <p class="text-muted small">Please sign in with your CRM credentials or choose a demo role below.</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                    </div>
                }

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Work Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" id="emailInput" class="form-control bg-light border-start-0" placeholder="name@crm.local" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" id="passwordInput" type="password" class="form-control bg-light border-start-0" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                            <label class="form-check-label small text-secondary" for="rememberMe">
                                Keep me signed in
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-4">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to CRM
                    </button>
                </form>

                <!-- One-Click Demo Role Selector -->
                <div class="border-top pt-3">
                    <div class="text-muted small text-center mb-2 fw-semibold">Quick Demo Login (One-Click)</div>
                    <div class="d-flex flex-column gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center justify-content-between" onclick="fillDemo('admin@crm.local', 'Admin@123')">
                            <span><i class="bi bi-shield-fill-check me-1"></i> System Administrator</span>
                            <span class="badge bg-primary">Admin</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-between" onclick="fillDemo('manager@crm.local', 'Manager@123')">
                            <span><i class="bi bi-people-fill me-1"></i> Sales Manager</span>
                            <span class="badge bg-secondary">Manager</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-info text-dark d-flex align-items-center justify-content-between" onclick="fillDemo('sales@crm.local', 'Sales@123')">
                            <span><i class="bi bi-person-badge-fill me-1"></i> Sales Executive</span>
                            <span class="badge bg-info text-dark">Executive</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillDemo(email, pass) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = pass;
            document.getElementById('loginForm').submit();
        }
    </script>
}
