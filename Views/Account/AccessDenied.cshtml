@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="d-flex flex-column align-items-center justify-content-center py-5 text-center">
    <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-4 mb-4" style="width: 90px; height: 90px; display: flex; align-items: center; justify-content: center;">
        <i class="bi bi-shield-x fs-1"></i>
    </div>
    <h2 class="fw-bold text-dark mb-2">403 - Access Denied</h2>
    <p class="text-muted max-w-md mb-4" style="max-width: 450px;">
        Your current role does not have permission to view this resource. Contact your CRM administrator if you believe this is an error.
    </p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4 shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>
