@{
    ViewData["Title"] = "Email Verified Successfully";
    Layout = "_Layout";
    var alreadyConfirmed = ViewBag.AlreadyConfirmed as bool? ?? false;
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5 px-3">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 text-center" style="max-width: 520px; width: 100%;">
        <div class="mb-4">
            <div class="rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-patch-check-fill fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">
                @(alreadyConfirmed ? "Email Already Verified" : "Email Successfully Verified!")
            </h3>
            <p class="text-muted small">
                Your company founder account is active and verified. You now have full access to your CRM workspace.
            </p>
        </div>

        <div class="d-flex flex-column gap-2">
            <a asp-action="Login" class="btn btn-primary py-2 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Your Workspace
            </a>
        </div>
    </div>
</div>
