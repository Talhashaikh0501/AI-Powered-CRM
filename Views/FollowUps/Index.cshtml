@model AI_Powered_CRM.ViewModels.FollowUpsViewModel
@{
    ViewData["Title"] = "Follow-Up Queues";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Follow-Up Action Queues</h3>
        <p class="text-muted small mb-0">
            Never lose a prospect to delayed outreach. Manage daily tasks, overdue alerts, and completion outcomes.
        </p>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-pills mb-4 gap-2" id="followUpTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active d-flex align-items-center gap-2 fw-semibold px-3" id="overdue-tab" data-bs-toggle="pill" data-bs-target="#overdue" type="button" role="tab">
            <i class="bi bi-exclamation-triangle-fill text-danger"></i>
            <span>Overdue</span>
            <span class="badge bg-danger rounded-pill">@Model.Overdue.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link d-flex align-items-center gap-2 fw-semibold px-3" id="today-tab" data-bs-toggle="pill" data-bs-target="#today" type="button" role="tab">
            <i class="bi bi-clock-fill text-warning"></i>
            <span>Due Today</span>
            <span class="badge bg-warning text-dark rounded-pill">@Model.Today.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link d-flex align-items-center gap-2 fw-semibold px-3" id="upcoming-tab" data-bs-toggle="pill" data-bs-target="#upcoming" type="button" role="tab">
            <i class="bi bi-calendar-check text-primary"></i>
            <span>Upcoming</span>
            <span class="badge bg-secondary rounded-pill">@Model.Upcoming.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link d-flex align-items-center gap-2 fw-semibold px-3" id="completed-tab" data-bs-toggle="pill" data-bs-target="#completed" type="button" role="tab">
            <i class="bi bi-check-circle-fill text-success"></i>
            <span>Completed</span>
            <span class="badge bg-success rounded-pill">@Model.Completed.Count</span>
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="followUpTabsContent">
    <!-- OVERDUE TAB -->
    <div class="tab-pane fade show active" id="overdue" role="tabpanel">
        <div class="crm-card p-4">
            <h6 class="fw-bold text-danger mb-3"><i class="bi bi-alarm-fill me-2"></i>Past-Due Follow-Up Queue</h6>
            @if (!Model.Overdue.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-emoji-smile fs-2 text-success d-block mb-2"></i>
                    <p class="small mb-0">No overdue follow-ups! Outreach SLA is 100% on schedule.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.Overdue)
                    {
                        <div class="list-group-item px-0 py-3 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-danger">Overdue</span>
                                    <span class="badge bg-light text-dark border">@item.Type</span>
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="fw-bold text-dark text-decoration-none">
                                        @item.Lead.Name
                                    </a>
                                    <span class="text-muted small">&bull; @(item.Lead.Company ?? item.Lead.InterestedProduct)</span>
                                </div>
                                <p class="small text-dark mb-1">@(item.Notes ?? "No notes specified")</p>
                                <div class="text-xs text-danger fw-semibold" style="font-size: 0.75rem;">
                                    Was Due: @item.DueAt.ToString("MMM dd, yyyy HH:mm UTC") &bull; Owner: @(item.AssignedUser?.FullName ?? item.AssignedUser?.UserName ?? "Staff")
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-success" onclick="openComplete(@item.FollowUpId)">
                                    <i class="bi bi-check-lg me-1"></i> Mark Done
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openReschedule(@item.FollowUpId)">
                                    <i class="bi bi-calendar-event me-1"></i> Reschedule
                                </button>
                                <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="btn btn-sm btn-outline-primary">
                                    Lead Workspace &rarr;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- TODAY TAB -->
    <div class="tab-pane fade" id="today" role="tabpanel">
        <div class="crm-card p-4">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-sun-fill text-warning me-2"></i>Today's Scheduled Outreach</h6>
            @if (!Model.Today.Any())
            {
                <div class="text-center py-4 text-muted small">
                    No follow-ups due today.
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.Today)
                    {
                        <div class="list-group-item px-0 py-3 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-warning text-dark">Due Today</span>
                                    <span class="badge bg-light text-dark border">@item.Type</span>
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="fw-bold text-dark text-decoration-none">
                                        @item.Lead.Name
                                    </a>
                                </div>
                                <p class="small text-dark mb-1">@(item.Notes ?? "No notes specified")</p>
                                <div class="text-xs text-muted" style="font-size: 0.75rem;">
                                    Scheduled Time: @item.DueAt.ToString("HH:mm UTC") &bull; Owner: @(item.AssignedUser?.FullName ?? item.AssignedUser?.UserName ?? "Staff")
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-success" onclick="openComplete(@item.FollowUpId)">
                                    <i class="bi bi-check-lg me-1"></i> Complete
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openReschedule(@item.FollowUpId)">
                                    <i class="bi bi-calendar-event me-1"></i> Reschedule
                                </button>
                                <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="btn btn-sm btn-outline-primary">
                                    Open &rarr;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- UPCOMING TAB -->
    <div class="tab-pane fade" id="upcoming" role="tabpanel">
        <div class="crm-card p-4">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-calendar3 me-2 text-primary"></i>Upcoming Outreach Queue</h6>
            @if (!Model.Upcoming.Any())
            {
                <div class="text-center py-4 text-muted small">No upcoming scheduled follow-ups.</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.Upcoming)
                    {
                        <div class="list-group-item px-0 py-3 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-secondary">Upcoming</span>
                                    <span class="badge bg-light text-dark border">@item.Type</span>
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="fw-bold text-dark text-decoration-none">
                                        @item.Lead.Name
                                    </a>
                                </div>
                                <p class="small text-dark mb-1">@(item.Notes ?? "No notes specified")</p>
                                <div class="text-xs text-muted" style="font-size: 0.75rem;">
                                    Scheduled: @item.DueAt.ToString("MMM dd, yyyy HH:mm UTC") &bull; Owner: @(item.AssignedUser?.FullName ?? item.AssignedUser?.UserName ?? "Staff")
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-success" onclick="openComplete(@item.FollowUpId)">
                                    <i class="bi bi-check-lg me-1"></i> Complete
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openReschedule(@item.FollowUpId)">
                                    <i class="bi bi-calendar-event me-1"></i> Reschedule
                                </button>
                                <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="btn btn-sm btn-outline-primary">
                                    Open &rarr;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- COMPLETED TAB -->
    <div class="tab-pane fade" id="completed" role="tabpanel">
        <div class="crm-card p-4">
            <h6 class="fw-bold text-success mb-3"><i class="bi bi-check2-all me-2"></i>Completed Follow-Ups Log</h6>
            @if (!Model.Completed.Any())
            {
                <div class="text-center py-4 text-muted small">No completed follow-ups logged yet.</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.Completed)
                    {
                        <div class="list-group-item px-0 py-3 border-bottom">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-success">Completed</span>
                                <span class="badge bg-light text-dark border">@item.Type</span>
                                <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="fw-bold text-dark text-decoration-none">
                                    @item.Lead.Name
                                </a>
                                <span class="text-muted text-xs ms-auto" style="font-size: 0.75rem;">
                                    Finished: @(item.CompletedAt?.ToString("g") ?? "N/A")
                                </span>
                            </div>
                            <p class="small text-dark mb-0">@(item.Notes ?? "No notes recorded")</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: Complete Follow-up -->
<div class="modal fade" id="completeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Complete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="followUpId" id="completeModalId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Record Follow-Up Outcome</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small fw-semibold">Outcome & Notes <span class="text-danger">*</span></label>
                    <textarea name="outcomeNotes" class="form-control" rows="3" placeholder="Client confirmed budget... Next meeting set for Friday." required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Mark Completed</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Reschedule Follow-up -->
<div class="modal fade" id="rescheduleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reschedule" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="followUpId" id="rescheduleModalId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Reschedule Follow-Up</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">New Due Date & Time (UTC) <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="newDueAt" class="form-control" value="@DateTime.UtcNow.AddDays(2).ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reason for Rescheduling</label>
                        <input type="text" name="reason" class="form-control" placeholder="Client requested later date..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save New Date</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openComplete(id) {
            document.getElementById('completeModalId').value = id;
            new bootstrap.Modal(document.getElementById('completeModal')).show();
        }

        function openReschedule(id) {
            document.getElementById('rescheduleModalId').value = id;
            new bootstrap.Modal(document.getElementById('rescheduleModal')).show();
        }
    </script>
}
