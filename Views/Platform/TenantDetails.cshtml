@model AI_Powered_CRM.ViewModels.PlatformTenantDetailsViewModel
@{
    ViewData["Title"] = $"Workspace Details - {Model.CompanyName}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary py-1 px-2 me-1">
                <i class="bi bi-arrow-left"></i> All Workspaces
            </a>
            <h3 class="fw-bold text-dark mb-0">@Model.CompanyName</h3>
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">@(Model.IsActive ? "Active" : "Disabled")</span>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle">@Model.Tier</span>
        </div>
        <p class="text-muted small mb-0">
            Tenant ID: <span class="font-monospace text-dark">@Model.TenantId</span> | Slug: <span class="font-monospace text-dark">/t/@Model.Slug</span>
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editPlanModal">
            <i class="bi bi-sliders me-1"></i> Adjust Plan & Quotas
        </button>
        <form asp-action="ToggleTenantStatus" method="post" class="d-inline" onsubmit="return confirm('Confirm changing activation status for @Model.CompanyName?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="TenantId" value="@Model.TenantId" />
            <input type="hidden" name="Reason" value="Status toggled from Tenant Details page" />
            <button type="submit" class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success") btn-sm">
                <i class="bi @(Model.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1"></i> @(Model.IsActive ? "Deactivate Workspace" : "Activate Workspace")
            </button>
        </form>
        <a asp-action="Support" asp-route-targetTenantId="@Model.TenantId" class="btn btn-primary btn-sm">
            <i class="bi bi-shield-plus me-1"></i> Request Support Access
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Quota & Usage Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="crm-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-semibold text-muted text-uppercase">Team Seats</span>
                <span class="badge @(Model.ActiveSeats >= Model.MaxUserSeats ? "bg-danger" : "bg-primary")">@Model.ActiveSeats / @Model.MaxUserSeats</span>
            </div>
            <div class="fs-4 fw-bold text-dark">@Model.ActiveSeats Active Members</div>
            <div class="progress mt-2" style="height: 6px;">
                <div class="progress-bar @(Model.ActiveSeats >= Model.MaxUserSeats ? "bg-danger" : "bg-primary")"
                     style="width: @(Model.MaxUserSeats > 0 ? Math.Min(100, (Model.ActiveSeats * 100) / Model.MaxUserSeats) : 0)%;"></div>
            </div>
            <small class="text-muted mt-2 d-block">Max Seat Limit: @Model.MaxUserSeats</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="crm-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-semibold text-muted text-uppercase">Leads Volume</span>
                <span class="badge bg-secondary">@Model.TotalLeadsCount / @Model.MaxLeadsQuota</span>
            </div>
            <div class="fs-4 fw-bold text-dark">@Model.TotalLeadsCount Stored Leads</div>
            <div class="progress mt-2" style="height: 6px;">
                <div class="progress-bar bg-success"
                     style="width: @(Model.MaxLeadsQuota > 0 ? Math.Min(100, (Model.TotalLeadsCount * 100) / Model.MaxLeadsQuota) : 0)%;"></div>
            </div>
            <small class="text-muted mt-2 d-block">Max Allowed Records: @Model.MaxLeadsQuota</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="crm-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-semibold text-muted text-uppercase">AI Inferences (Month)</span>
                <span class="badge @(Model.MonthlyAiRequestLimit > 0 && Model.CurrentMonthAiUsageCount >= Model.MonthlyAiRequestLimit ? "bg-danger" : "bg-info text-dark")">@Model.CurrentMonthAiUsageCount / @Model.MonthlyAiRequestLimit</span>
            </div>
            <div class="fs-4 fw-bold text-dark">@Model.CurrentMonthAiUsageCount Calls Used</div>
            <div class="progress mt-2" style="height: 6px;">
                <div class="progress-bar bg-info"
                     style="width: @(Model.MonthlyAiRequestLimit > 0 ? Math.Min(100, (Model.CurrentMonthAiUsageCount * 100) / Model.MonthlyAiRequestLimit) : 0)%;"></div>
            </div>
            <small class="text-muted mt-2 d-block">Monthly AI Quota: @Model.MonthlyAiRequestLimit</small>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Left Column: Workspace Profile & Settings -->
    <div class="col-lg-5">
        <div class="crm-card p-4 h-100">
            <h5 class="fw-bold text-dark mb-3">Workspace Profile</h5>
            <dl class="row mb-0 small">
                <dt class="col-sm-5 text-muted">Primary Email:</dt>
                <dd class="col-sm-7 fw-semibold font-monospace">@Model.ContactEmail</dd>

                <dt class="col-sm-5 text-muted">Phone Number:</dt>
                <dd class="col-sm-7">@(Model.Phone ?? "Not specified")</dd>

                <dt class="col-sm-5 text-muted">Subscription Status:</dt>
                <dd class="col-sm-7"><span class="badge bg-light text-dark border">@Model.Status</span></dd>

                <dt class="col-sm-5 text-muted">Trial Expiration:</dt>
                <dd class="col-sm-7">@(Model.TrialEndsAt.HasValue ? Model.TrialEndsAt.Value.ToString("dd MMM yyyy") : "N/A")</dd>

                <dt class="col-sm-5 text-muted">Currency:</dt>
                <dd class="col-sm-7">@Model.DefaultCurrency (@Model.CurrencySymbol)</dd>

                <dt class="col-sm-5 text-muted">Time Zone:</dt>
                <dd class="col-sm-7">@Model.TimeZoneId</dd>

                <dt class="col-sm-5 text-muted">Lead Assignment:</dt>
                <dd class="col-sm-7"><span class="badge bg-secondary">@Model.LeadAssignmentMode</span></dd>

                <dt class="col-sm-5 text-muted">Lead Exporting:</dt>
                <dd class="col-sm-7">@(Model.RestrictLeadExport ? "Restricted to Admins" : "Open to All Reps")</dd>

                <dt class="col-sm-5 text-muted">Created Date:</dt>
                <dd class="col-sm-7 text-muted">@Model.CreatedAt.ToString("g")</dd>
            </dl>
        </div>
    </div>

    <!-- Right Column: Team Members -->
    <div class="col-lg-7">
        <div class="crm-card p-4 h-100">
            <h5 class="fw-bold text-dark mb-3">Team Members (@Model.Members.Count)</h5>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light text-muted">
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Joined</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Members.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No members registered.</td></tr>
                        }
                        @foreach (var m in Model.Members)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold text-dark d-block">@m.FullName</span>
                                    <small class="text-muted font-monospace">@m.Email</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@m.Role</span></td>
                                <td><span class="badge @(m.IsActive ? "bg-success" : "bg-secondary")">@(m.IsActive ? "Active" : "Disabled")</span></td>
                                <td class="text-muted small">@m.JoinedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Tenant Audit Logs -->
<div class="crm-card p-4">
    <h5 class="fw-bold text-dark mb-1">Recent Workspace Security & Activity Logs</h5>
    <small class="text-muted d-block mb-3">Latest audit entries recorded for tenant isolation and compliance</small>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.82rem;">
            <thead class="table-light text-muted">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Performed By</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentAudits.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">No audit records found.</td></tr>
                }
                @foreach (var a in Model.RecentAudits)
                {
                    <tr>
                        <td class="text-muted font-monospace">@a.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span class="badge bg-secondary bg-opacity-25 text-dark">@a.Action</span></td>
                        <td>@a.EntityType</td>
                        <td class="fw-semibold">@a.PerformedBy</td>
                        <td class="font-monospace text-truncate" style="max-width: 250px;" title="@a.Details">@(a.Details ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Edit Plan & Quotas Modal -->
<div class="modal fade" id="editPlanModal" tabindex="-1" aria-labelledby="editPlanModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateTenantPlan" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TenantId" value="@Model.TenantId" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="editPlanModalLabel">Adjust Plan & Quotas (@Model.CompanyName)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> Changes take effect immediately without billing transaction processing.
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Subscription Tier</label>
                        <select name="SubscriptionTier" class="form-select form-select-sm" asp-for="Tier" asp-items="Html.GetEnumSelectList<AI_Powered_CRM.Models.Enums.SubscriptionTier>()"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Subscription Status</label>
                        <select name="SubscriptionStatus" class="form-select form-select-sm" asp-for="Status" asp-items="Html.GetEnumSelectList<AI_Powered_CRM.Models.Enums.SubscriptionStatus>()"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Max User Seats</label>
                        <input type="number" name="MaxUserSeats" value="@Model.MaxUserSeats" min="1" max="1000" class="form-control form-control-sm" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Max Leads Quota</label>
                        <input type="number" name="MaxLeadsQuota" value="@Model.MaxLeadsQuota" min="10" max="500000" class="form-control form-control-sm" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Monthly AI Request Limit</label>
                        <input type="number" name="MonthlyAiRequestLimit" value="@Model.MonthlyAiRequestLimit" min="0" max="100000" class="form-control form-control-sm" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Operational Reason / Notes</label>
                        <input type="text" name="Reason" placeholder="e.g. VIP Customer expansion grant" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary fw-semibold">Save Adjustments</button>
                </div>
            </form>
        </div>
    </div>
</div>
