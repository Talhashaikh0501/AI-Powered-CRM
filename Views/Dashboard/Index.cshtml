@model AI_Powered_CRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Command Center Dashboard";
}

<!-- Welcome Banner -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
            <span>Sales Command Center</span>
            <span class="badge bg-primary bg-opacity-10 text-primary fs-6 fw-semibold px-2 py-1">
                @Model.UserRole
            </span>
        </h3>
        <p class="text-muted small mb-0">
            Real-time pipeline analytics, AI-assisted lead scoring, and action-oriented follow-up queues.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Pipeline" asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-kanban"></i> Pipeline Kanban
        </a>
        <a asp-controller="Leads" asp-action="Create" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-plus-lg"></i> Create Lead
        </a>
    </div>
</div>

<!-- AI Pipeline Executive Summary (Admins & Managers) -->
@if (Model.Summary.AIPipelineSummary != null)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" 
         style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary text-white px-2 py-1 d-flex align-items-center gap-1 shadow-sm">
                        <i class="bi bi-stars"></i> AI Pipeline Intelligence
                    </span>
                    <span class="text-white-50 small">Generated @Model.Summary.AIPipelineSummary.GeneratedAt</span>
                </div>
                <span class="badge bg-white bg-opacity-10 text-light border border-white border-opacity-20 small">
                    Advisor Mode
                </span>
            </div>

            <div class="row g-3">
                <div class="col-lg-5">
                    <h6 class="text-info fw-bold small text-uppercase mb-1"><i class="bi bi-graph-up-arrow me-1"></i> Executive Observation</h6>
                    <p class="text-light text-opacity-90 small mb-0 lh-base">
                        @Model.Summary.AIPipelineSummary.ObservationSummary
                    </p>
                </div>
                <div class="col-lg-4 border-start-lg border-white border-opacity-10">
                    <h6 class="text-warning fw-bold small text-uppercase mb-1"><i class="bi bi-exclamation-octagon me-1"></i> Immediate Attention</h6>
                    <p class="text-light text-opacity-90 small mb-0 lh-base">
                        @Model.Summary.AIPipelineSummary.UrgentAttentionItems
                    </p>
                </div>
                <div class="col-lg-3 border-start-lg border-white border-opacity-10">
                    <h6 class="text-success fw-bold small text-uppercase mb-1"><i class="bi bi-cash-coin me-1"></i> Conversion Outlook</h6>
                    <p class="text-light text-opacity-90 small mb-0 lh-base">
                        @Model.Summary.AIPipelineSummary.RevenueOpportunityForecast
                    </p>
                </div>
            </div>
        </div>
    </div>
}

<!-- KPI Metric Cards Grid -->
<div class="row g-3 mb-4">
    <!-- Total Active Leads -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="crm-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center text-muted mb-2">
                <span class="small fw-semibold text-uppercase">Active Leads</span>
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <div class="fs-4 fw-bold text-dark">@Model.Summary.TotalActiveLeads</div>
            <div class="small text-muted mt-1">
                <span class="text-primary fw-semibold">@Model.Summary.NewLeadsCount New</span> this period
            </div>
        </div>
    </div>

    <!-- Hot Deals -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="crm-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center text-muted mb-2">
                <span class="small fw-semibold text-uppercase">Hot Prospects</span>
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="bi bi-fire"></i>
                </div>
            </div>
            <div class="fs-4 fw-bold text-danger">@Model.Summary.HotLeadsCount</div>
            <div class="small text-muted mt-1">AI Score &ge; 75 / 100</div>
        </div>
    </div>

    <!-- Active Pipeline Value -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="crm-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center text-muted mb-2">
                <span class="small fw-semibold text-uppercase">Pipeline Value</span>
                <div class="rounded-circle bg-info bg-opacity-10 text-info p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="bi bi-briefcase"></i>
                </div>
            </div>
            <div class="fs-4 fw-bold text-dark">@AI_Powered_CRM.Helpers.CurrencyHelper.FormatINRRounded(Model.Summary.TotalPipelineValue)</div>
            <div class="small text-muted mt-1">Open pipeline deals</div>
        </div>
    </div>

    <!-- Closed Revenue / Won Value -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="crm-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center text-muted mb-2">
                <span class="small fw-semibold text-uppercase">Won Value (Est.)</span>
                <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
            <div class="fs-4 fw-bold text-success">@AI_Powered_CRM.Helpers.CurrencyHelper.FormatINRRounded(Model.Summary.EstimatedConvertedValue)</div>
            <div class="small text-muted mt-1">@Model.Summary.ConvertedCount deals won (est.)</div>
        </div>
    </div>

    <!-- Win Rate -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="crm-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center text-muted mb-2">
                <span class="small fw-semibold text-uppercase">Win Rate</span>
                <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="bi bi-trophy"></i>
                </div>
            </div>
            <div class="fs-4 fw-bold text-dark">@Model.Summary.WinRatePercentage%</div>
            <div class="small text-muted mt-1">Conversion ratio</div>
        </div>
    </div>

    <!-- Overdue Follow-ups -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="crm-card p-3 h-100 @(Model.Summary.FollowUpsOverdueCount > 0 ? "border-danger border-opacity-50" : "")">
            <div class="d-flex justify-content-between align-items-center text-muted mb-2">
                <span class="small fw-semibold text-uppercase">Overdue Tasks</span>
                <div class="rounded-circle @(Model.Summary.FollowUpsOverdueCount > 0 ? "bg-danger text-white" : "bg-light text-muted") p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="bi bi-alarm"></i>
                </div>
            </div>
            <div class="fs-4 fw-bold @(Model.Summary.FollowUpsOverdueCount > 0 ? "text-danger" : "text-dark")">
                @Model.Summary.FollowUpsOverdueCount
            </div>
            <div class="small text-muted mt-1">
                <span class="text-primary fw-semibold">@Model.Summary.FollowUpsDueTodayCount due today</span>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- Pipeline Stage Distribution Bar Chart -->
    <div class="col-lg-8">
        <div class="crm-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="fw-bold text-dark mb-0">Pipeline Stage Funnel</h6>
                    <small class="text-muted">Distribution of deals across CRM workflow stages</small>
                </div>
                <a asp-controller="Pipeline" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">
                    View Board &rarr;
                </a>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="stageChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Lead Sources Doughnut Chart -->
    <div class="col-lg-4">
        <div class="crm-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="fw-bold text-dark mb-0">Acquisition Channels</h6>
                    <small class="text-muted">Lead volume by origin</small>
                </div>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="sourceChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Bottom Section: Urgent Follow-ups & Activity Stream -->
<div class="row g-4">
    <!-- Urgent Follow-ups -->
    <div class="col-lg-6">
        <div class="crm-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <h6 class="fw-bold text-dark mb-0">High-Priority Follow-Ups</h6>
                    <span class="badge bg-danger rounded-pill">@Model.Summary.UrgentFollowUps.Count</span>
                </div>
                <a asp-controller="FollowUps" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">
                    All Queues &rarr;
                </a>
            </div>

            @if (!Model.Summary.UrgentFollowUps.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-check2-circle fs-2 text-success mb-2 d-block"></i>
                    <p class="small mb-0">No overdue or urgent tasks pending! Great job staying ahead.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.Summary.UrgentFollowUps)
                    {
                        var isOverdue = item.DueAt < DateTime.UtcNow;
                        <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge @(isOverdue ? "bg-danger" : "bg-warning text-dark")">
                                        @(isOverdue ? "Overdue" : "Due Today")
                                    </span>
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="fw-bold text-dark text-decoration-none">
                                        @item.Lead.Name
                                    </a>
                                    <span class="text-muted small">&bull; @item.Type</span>
                                </div>
                                <div class="text-muted small text-truncate" style="max-width: 320px;">
                                    @(item.Notes ?? "No notes specified")
                                </div>
                                <div class="text-xs text-muted" style="font-size: 0.72rem;">
                                    Due: @item.DueAt.ToString("MMM dd, yyyy HH:mm UTC") | Assigned: @(item.AssignedUser?.FullName ?? item.AssignedUser?.UserName ?? "Unassigned")
                                </div>
                            </div>
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="btn btn-sm btn-outline-primary">
                                View Lead
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Recent Activities Timeline -->
    <div class="col-lg-6">
        <div class="crm-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">Recent Activity Stream</h6>
                <small class="text-muted">Live audit trail</small>
            </div>

            @if (!Model.Summary.RecentActivities.Any())
            {
                <div class="text-center py-4 text-muted">
                    <p class="small mb-0">No customer interactions logged yet.</p>
                </div>
            }
            else
            {
                <div class="timeline position-relative ps-3 border-start">
                    @foreach (var act in Model.Summary.RecentActivities)
                    {
                        <div class="mb-3 position-relative ps-3">
                            <div class="position-absolute rounded-circle bg-primary" 
                                 style="width: 10px; height: 10px; left: -21px; top: 4px;"></div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold small text-dark">
                                    <span class="badge bg-light text-dark border me-1">@act.Type</span>
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@act.LeadId" class="text-dark text-decoration-none">
                                        @act.Lead.Name
                                    </a>
                                </span>
                                <span class="text-muted text-xs" style="font-size: 0.72rem;">
                                    @act.OccurredAt.ToString("MMM dd, HH:mm")
                                </span>
                            </div>
                            <p class="small text-muted mb-0 mt-1">@act.Description</p>
                            <span class="text-xs text-secondary" style="font-size: 0.7rem;">Logged by @(act.User?.FullName ?? act.User?.UserName ?? "Staff")</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Chart.js Stage Funnel
        const stageData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.StageDistribution));
        const stageLabels = Object.keys(stageData);
        const stageValues = Object.values(stageData);

        const ctxStage = document.getElementById('stageChart').getContext('2d');
        new Chart(ctxStage, {
            type: 'bar',
            data: {
                labels: stageLabels,
                datasets: [{
                    label: 'Deals Count',
                    data: stageValues,
                    backgroundColor: [
                        '#64748b', '#0284c7', '#3b82f6', '#6366f1', '#8b5cf6', '#d97706', '#10b981', '#ef4444'
                    ],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });

        // Chart.js Source Breakdown
        const sourceData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.SourceDistribution));
        const sourceLabels = Object.keys(sourceData);
        const sourceValues = Object.values(sourceData);

        const ctxSource = document.getElementById('sourceChart').getContext('2d');
        new Chart(ctxSource, {
            type: 'doughnut',
            data: {
                labels: sourceLabels,
                datasets: [{
                    data: sourceValues,
                    backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#64748b']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12 } }
                }
            }
        });
    </script>
}
