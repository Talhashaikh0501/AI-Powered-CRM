@model AI_Powered_CRM.ViewModels.PipelineViewModel
@{
    ViewData["Title"] = "Kanban Pipeline";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Visual Deal Pipeline Kanban</h3>
        <p class="text-muted small mb-0">
            Drag and drop deals across stages. All pipeline shifts automatically update stage audit history.
        </p>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="crm-card px-3 py-2 d-flex align-items-center gap-2">
            <span class="text-muted small">Active Pipeline:</span>
            <span class="fw-bold text-success fs-6">$@Model.TotalActivePipelineValue.ToString("N0")</span>
            <span class="badge bg-light text-dark border">@Model.TotalActiveDealsCount Deals</span>
        </div>
        <a asp-controller="Leads" asp-action="Create" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-plus-lg"></i> Add Deal
        </a>
    </div>
</div>

@Html.AntiForgeryToken()

<!-- Kanban Columns Container (Horizontal Scroll) -->
<div class="d-flex gap-3 overflow-auto pb-4" style="min-height: 75vh;">
    @foreach (var stage in Model.Stages)
    {
        var stageLeads = stage.Value;
        var stageVal = stageLeads.Where(l => l.Budget.HasValue).Sum(l => l.Budget!.Value);

        var isWon = stage.Key == LeadStatus.Converted;
        var isLost = stage.Key == LeadStatus.Lost;

        <div class="kanban-column d-flex flex-column rounded-3 p-2 bg-light border" 
             style="min-width: 290px; max-width: 310px; flex-shrink: 0; background-color: #f1f5f9 !important;">
            <!-- Column Header -->
            <div class="d-flex justify-content-between align-items-center p-2 mb-2 bg-white rounded-2 shadow-sm border">
                <div>
                    <span class="fw-bold small text-dark d-block">@stage.Key</span>
                    <span class="text-success text-xs fw-semibold" style="font-size: 0.72rem;">
                        $@stageVal.ToString("N0")
                    </span>
                </div>
                <span class="badge @(isWon ? "bg-success" : (isLost ? "bg-danger" : "bg-secondary")) rounded-pill">
                    @stageLeads.Count
                </span>
            </div>

            <!-- Draggable Cards Container -->
            <div class="kanban-cards-list d-flex flex-column gap-2 flex-grow-1 overflow-auto" 
                 data-stage="@stage.Key" id="stage-@stage.Key" style="min-height: 200px;">
                @foreach (var lead in stageLeads)
                {
                    var latestAi = lead.AIInsights.OrderByDescending(i => i.GeneratedAt).FirstOrDefault();
                    var score = latestAi?.Score ?? 0;
                    var aiClass = latestAi?.Classification.ToString() ?? "Warm";

                    <div class="kanban-card crm-card p-3 shadow-sm bg-white" data-lead-id="@lead.LeadId" style="cursor: grab;">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="badge @(aiClass == "Hot" ? "badge-hot" : (aiClass == "Warm" ? "badge-warm" : "badge-cold"))" style="font-size: 0.68rem;">
                                @aiClass (@score)
                            </span>
                            <span class="fw-bold text-success small">
                                @(lead.Budget.HasValue ? "$" + lead.Budget.Value.ToString("N0") : "No budget")
                            </span>
                        </div>

                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@lead.LeadId" class="fw-bold text-dark text-decoration-none d-block small mb-1">
                            @lead.Name
                        </a>
                        <div class="text-muted text-xs text-truncate mb-2" style="font-size: 0.75rem;">
                            @(lead.Company ?? lead.InterestedProduct)
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-1">
                            <div class="d-flex align-items-center gap-1 text-muted" style="font-size: 0.72rem;">
                                <i class="bi bi-person text-secondary"></i>
                                <span class="text-truncate" style="max-width: 100px;">
                                    @(lead.OwnerUser?.FullName ?? lead.OwnerUser?.UserName ?? "Unassigned")
                                </span>
                            </div>
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@lead.LeadId" class="btn btn-xs btn-outline-primary py-0 px-1" style="font-size: 0.7rem;">
                                View &rarr;
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const columns = document.querySelectorAll('.kanban-cards-list');

            columns.forEach(col => {
                new Sortable(col, {
                    group: 'pipeline',
                    animation: 150,
                    ghostClass: 'bg-primary-subtle',
                    onEnd: function (evt) {
                        const itemEl = evt.item;
                        const leadId = itemEl.getAttribute('data-lead-id');
                        const newStage = evt.to.getAttribute('data-stage');

                        if (evt.from !== evt.to) {
                            fetch('/Pipeline/MoveStage', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': token
                                },
                                body: JSON.stringify({
                                    leadId: parseInt(leadId),
                                    newStatus: newStage,
                                    notes: 'Moved via Kanban drag-and-drop'
                                })
                            })
                            .then(res => res.json())
                            .then(data => {
                                if (!data.success) {
                                    alert('Failed to update stage. Reverting...');
                                    location.reload();
                                }
                            })
                            .catch(err => {
                                console.error(err);
                                location.reload();
                            });
                        }
                    }
                });
            });
        });
    </script>
}
