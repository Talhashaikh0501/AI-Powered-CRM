@model AI_Powered_CRM.ViewModels.AIInsightsViewModel
@{
    ViewData["Title"] = "AI Sales Intelligence";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bold text-dark mb-0">AI Sales Intelligence Dashboard</h3>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle">
                <i class="bi bi-stars me-1"></i>Groq AI Engine
            </span>
        </div>
        <p class="text-muted small mb-0">
            Real-time lead qualification scores, deal conversion estimates, and automated next-best-action recommendations.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-bar-chart-line me-1"></i> Conversion Reports
        </a>
        <a asp-controller="Leads" asp-action="Index" class="btn btn-primary btn-sm">
            <i class="bi bi-people-fill me-1"></i> View All Leads
        </a>
    </div>
</div>

<!-- AI Quota Consumption Banner -->
<div class="crm-card p-3 mb-4 bg-white shadow-sm border-start border-4 border-primary">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="bi bi-cpu fs-4"></i>
            </div>
            <div>
                <h6 class="fw-bold text-dark mb-0">Monthly AI Inference Consumption</h6>
                <small class="text-muted">Quota resets at the start of next billing cycle</small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3" style="min-width: 280px;">
            <div class="flex-grow-1">
                <div class="d-flex justify-content-between small mb-1">
                    <span class="text-muted">Consumed:</span>
                    <span class="fw-bold text-dark">@Model.CurrentMonthAiUsageCount / @Model.MonthlyAiRequestLimit Calls (@Model.AiQuotaPercent%)</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar @(Model.AiQuotaPercent >= 90 ? "bg-danger" : (Model.AiQuotaPercent >= 70 ? "bg-warning" : "bg-primary"))"
                         role="progressbar" style="width: @Model.AiQuotaPercent%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Qualification Distribution Cards -->
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-sm-6">
        <div class="crm-card p-3 h-100 border-start border-4 border-danger">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="small fw-semibold text-muted text-uppercase">Hot Opportunities</span>
                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle">@Model.HotPercent%</span>
            </div>
            <div class="fs-2 fw-bold text-danger mb-1">@Model.HotLeadsCount</div>
            <small class="text-muted">High intent, immediate closing potential</small>
        </div>
    </div>

    <div class="col-lg-3 col-sm-6">
        <div class="crm-card p-3 h-100 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="small fw-semibold text-muted text-uppercase">Warm Prospects</span>
                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning-subtle">@Model.WarmPercent%</span>
            </div>
            <div class="fs-2 fw-bold text-warning mb-1">@Model.WarmLeadsCount</div>
            <small class="text-muted">Engaged leads requiring nurturing</small>
        </div>
    </div>

    <div class="col-lg-3 col-sm-6">
        <div class="crm-card p-3 h-100 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="small fw-semibold text-muted text-uppercase">Cold / Discovery</span>
                <span class="badge bg-info bg-opacity-10 text-info border border-info-subtle">@Model.ColdPercent%</span>
            </div>
            <div class="fs-2 fw-bold text-info mb-1">@Model.ColdLeadsCount</div>
            <small class="text-muted">Early stage or low responsive leads</small>
        </div>
    </div>

    <div class="col-lg-3 col-sm-6">
        <div class="crm-card p-3 h-100 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="small fw-semibold text-muted text-uppercase">High-Prob. Pipeline</span>
                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">Est. INR</span>
            </div>
            <div class="fs-2 fw-bold text-success mb-1">
                @AI_Powered_CRM.Helpers.CurrencyHelper.FormatINRRounded(Model.HighProbabilityPipelineValue)
            </div>
            <small class="text-muted">Out of @AI_Powered_CRM.Helpers.CurrencyHelper.FormatINRRounded(Model.TotalActivePipelineValue) total pipeline</small>
        </div>
    </div>
</div>

<!-- Priority Opportunities Table -->
<div class="crm-card p-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
        <div>
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Priority Conversion Opportunities
            </h5>
            <small class="text-muted">Top high-score deals ranked by conversion probability and estimated revenue potential</small>
        </div>
        <div>
            <a asp-action="ExportConversionCsv" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-download me-1"></i> Export Analytics CSV
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light text-muted text-uppercase" style="font-size: 0.72rem;">
                <tr>
                    <th class="ps-3">Lead & Organization</th>
                    <th>AI Score</th>
                    <th>Est. Budget (₹)</th>
                    <th>Recommended Next Action</th>
                    <th>Risk</th>
                    <th>Sales Owner</th>
                    <th class="text-end pe-3">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.PriorityOpportunities.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-stars fs-1 text-secondary mb-2 d-block"></i>
                            No active high-probability opportunities found. Score your leads to generate recommendations.
                        </td>
                    </tr>
                }
                @foreach (var opp in Model.PriorityOpportunities)
                {
                    <tr>
                        <td class="ps-3">
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@opp.LeadId" class="fw-bold text-dark text-decoration-none d-block hover-primary">
                                @opp.Name
                            </a>
                            <small class="text-muted">@opp.Company</small>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @(opp.Classification == "Hot" ? "badge-hot" : (opp.Classification == "Warm" ? "badge-warm" : "badge-cold"))">
                                    @opp.Classification (@opp.Score)
                                </span>
                            </div>
                        </td>
                        <td class="fw-bold text-success">
                            @(opp.BudgetInr.HasValue ? AI_Powered_CRM.Helpers.CurrencyHelper.FormatINRRounded(opp.BudgetInr.Value) : "₹0")
                        </td>
                        <td style="max-width: 320px;">
                            <span class="small text-dark d-block text-truncate" title="@opp.NextBestAction">
                                <i class="bi bi-arrow-right-circle text-primary me-1"></i>@opp.NextBestAction
                            </span>
                        </td>
                        <td>
                            <span class="badge @(opp.RiskLevel == "High" ? "bg-danger" : (opp.RiskLevel == "Medium" ? "bg-warning text-dark" : "bg-success"))" style="font-size: 0.7rem;">
                                @opp.RiskLevel Risk
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1 text-muted small">
                                <i class="bi bi-person text-secondary"></i>
                                <span>@opp.OwnerName</span>
                            </div>
                        </td>
                        <td class="text-end pe-3">
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@opp.LeadId" class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size: 0.75rem;">
                                Intelligence &rarr;
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
