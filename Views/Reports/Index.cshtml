@model AI_Powered_CRM.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Conversion & Performance Reports";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Executive Analytics & Conversion Reports</h3>
        <p class="text-muted small mb-0">
            Deep insights into pipeline velocity, acquisition channel ROI, and sales rep performance.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Insights" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-stars me-1"></i> AI Intelligence
        </a>
        <a asp-action="ExportConversionCsv" class="btn btn-outline-secondary btn-sm" title="Download executive summary and channel ROI as CSV">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export Report CSV
        </a>
        <a asp-action="ExportLeadsCsv" class="btn btn-primary btn-sm" title="Export complete lead dataset">
            <i class="bi bi-download me-1"></i> Export Leads CSV
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Conversion Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-sm-6">
        <div class="crm-card p-3">
            <div class="small fw-semibold text-muted text-uppercase mb-1">Win Rate Ratio</div>
            <div class="fs-3 fw-bold text-dark">@Model.ConversionReport.ConversionRate%</div>
            <div class="small text-muted">@Model.ConversionReport.ConvertedLeads won out of @(Model.ConversionReport.ConvertedLeads + Model.ConversionReport.LostLeads) closed</div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="crm-card p-3">
            <div class="small fw-semibold text-muted text-uppercase mb-1">Won Deal Value (Est.)</div>
            <div class="fs-3 fw-bold text-success">@AI_Powered_CRM.Helpers.CurrencyHelper.FormatINRRounded(Model.ConversionReport.TotalWonDealValue)</div>
            <div class="small text-muted">Closed deal budget value (estimated)</div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="crm-card p-3">
            <div class="small fw-semibold text-muted text-uppercase mb-1">Average Deal Size</div>
            <div class="fs-3 fw-bold text-primary">@AI_Powered_CRM.Helpers.CurrencyHelper.FormatINRRounded(Model.ConversionReport.AverageDealSize)</div>
            <div class="small text-muted">Per converted customer</div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="crm-card p-3">
            <div class="small fw-semibold text-muted text-uppercase mb-1">Total Leads Tracked</div>
            <div class="fs-3 fw-bold text-dark">@Model.ConversionReport.TotalLeads</div>
            <div class="small text-muted">Across all channels</div>
        </div>
    </div>
</div>

<!-- Acquisition Channels ROI Table -->
<div class="crm-card p-4 mb-4">
    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-funnel-fill text-primary me-2"></i>Acquisition Channel Performance & ROI</h6>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light text-muted text-uppercase" style="font-size: 0.72rem;">
                <tr>
                    <th>Lead Source Channel</th>
                    <th>Total Leads</th>
                    <th>Deals Converted</th>
                    <th>Conversion Rate</th>
                    <th class="text-end">Won Deal Value (Est.)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.SourcePerformance)
                {
                    <tr>
                        <td class="fw-bold text-dark">@s.Source</td>
                        <td>@s.LeadCount</td>
                        <td><span class="badge bg-success bg-opacity-10 text-success">@s.ConvertedCount Won</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="width: 80px; height: 6px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @s.ConversionRate%"></div>
                                </div>
                                <span class="small fw-semibold">@s.ConversionRate%</span>
                            </div>
                        </td>
                        <td class="text-end fw-bold text-success">@AI_Powered_CRM.Helpers.CurrencyHelper.FormatINRRounded(s.EstimatedWonValue)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Sales Representative Leaderboard -->
<div class="crm-card p-4">
    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-award-fill text-warning me-2"></i>Sales Representative Leaderboard</h6>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light text-muted text-uppercase" style="font-size: 0.72rem;">
                <tr>
                    <th>Sales Representative</th>
                    <th>Assigned Leads</th>
                    <th>Completed Follow-Ups</th>
                    <th>Deals Won</th>
                    <th>Win Rate %</th>
                    <th class="text-end">Closed Deal Value (Est.)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rep in Model.StaffPerformance)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-dark text-white p-2 d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                    @rep.StaffName.Substring(0, 1)
                                </div>
                                <span class="fw-bold text-dark">@rep.StaffName</span>
                            </div>
                        </td>
                        <td>@rep.AssignedLeadsCount</td>
                        <td><span class="badge bg-light text-dark border">@rep.CompletedFollowUpsCount Completed</span></td>
                        <td><span class="badge bg-success">@rep.ConvertedLeadsCount Won</span></td>
                        <td><span class="fw-semibold text-dark">@rep.ConversionRate%</span></td>
                        <td class="text-end fw-bold text-success fs-6">@AI_Powered_CRM.Helpers.CurrencyHelper.FormatINRRounded(rep.ClosedRevenue)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
