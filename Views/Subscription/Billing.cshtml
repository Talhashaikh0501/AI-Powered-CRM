@model AI_Powered_CRM.ViewModels.BillingHistoryViewModel
@{
    ViewData["Title"] = "Billing History & Invoices";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bold text-dark mb-0">Billing & Invoices</h3>
            <span class="badge bg-light text-dark border">@Model.CompanyName</span>
        </div>
        <p class="text-muted small mb-0">
            View generated tax invoices, trial receipts, and billing transaction history.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Subscription Dashboard
        </a>
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#paymentComingSoonModal">
            <i class="bi bi-credit-card me-1"></i> Payment Method
        </button>
    </div>
</div>

<!-- Billing Summary Card -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="crm-card p-3">
            <span class="text-muted small d-block">Current Plan Tier</span>
            <div class="d-flex align-items-center justify-content-between mt-1">
                <h5 class="fw-bold text-dark mb-0">@Model.CurrentTier</h5>
                <span class="badge bg-primary">Active</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="crm-card p-3">
            <span class="text-muted small d-block">Billing Currency</span>
            <div class="d-flex align-items-center justify-content-between mt-1">
                <h5 class="fw-bold text-dark mb-0">INR (@Model.CurrencySymbol)</h5>
                <span class="badge bg-light text-dark border">India</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="crm-card p-3">
            <span class="text-muted small d-block">Outstanding Balance</span>
            <div class="d-flex align-items-center justify-content-between mt-1">
                <h5 class="fw-bold text-success mb-0">₹0.00</h5>
                <span class="badge bg-success bg-opacity-10 text-success">All Clear</span>
            </div>
        </div>
    </div>
</div>

<!-- Invoices Table Section -->
<div class="crm-card overflow-hidden mb-4">
    <div class="p-3 border-bottom bg-light d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
        <h6 class="fw-bold text-dark mb-0">Invoice Archive (@Model.Invoices.Count)</h6>
        <div class="d-flex align-items-center gap-2">
            <span class="small text-muted">Filter:</span>
            <select class="form-select form-select-sm" style="width: auto;" id="invoiceFilter">
                <option value="All" selected>All Transactions</option>
                <option value="Trial">Trial / Complimentary</option>
                <option value="Paid">Paid Invoices</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light text-muted text-uppercase" style="font-size: 0.72rem;">
                <tr>
                    <th class="ps-4">Invoice #</th>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th>Payment Method</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Receipt</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Invoices.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="text-muted mb-2"><i class="bi bi-file-earmark-text fs-2"></i></div>
                            <h6 class="fw-bold text-dark">No Invoices Generated Yet</h6>
                            <p class="text-muted small mb-0" style="max-width: 500px; margin: 0 auto;">
                                Your workspace is currently utilizing our complimentary evaluation tier. Official GST tax invoices will be archived here once payment billing is enabled.
                            </p>
                        </td>
                    </tr>
                }
                @foreach (var inv in Model.Invoices)
                {
                    <tr class="invoice-row" data-type="@(inv.AmountInr == 0 ? "Trial" : "Paid")">
                        <td class="ps-4 font-monospace fw-semibold text-dark">@inv.InvoiceNumber</td>
                        <td class="small text-muted">@inv.Date.ToString("MMM dd, yyyy")</td>
                        <td class="small fw-semibold text-dark">@inv.Description</td>
                        <td class="small font-monospace fw-bold text-dark">
                            @(inv.AmountInr == 0 ? "₹0.00" : $"{inv.CurrencySymbol}{inv.AmountInr:N2}")
                        </td>
                        <td class="small text-muted">@inv.PaymentMethod</td>
                        <td>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                <i class="bi bi-check2-circle me-1"></i> @inv.Status
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.78rem;"
                                    data-bs-toggle="modal" data-bs-target="#paymentComingSoonModal">
                                <i class="bi bi-download me-1"></i> Download
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Honest Billing Disclaimer -->
<div class="alert alert-light border rounded-3 p-3 small text-muted d-flex align-items-center gap-3">
    <i class="bi bi-info-circle-fill text-primary fs-4 flex-shrink-0"></i>
    <div>
        <strong>Transparent SaaS Billing:</strong> All financial and subscription billing services are strictly non-chargeable during this release phase. Payment processing through Razorpay, Stripe, and UPI will be introduced in the final launch milestone without altering your existing CRM data.
    </div>
</div>

<partial name="_PaymentComingSoonModal" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const filter = document.getElementById('invoiceFilter');
            const rows = document.querySelectorAll('.invoice-row');

            filter.addEventListener('change', function () {
                const selected = this.value;
                rows.forEach(row => {
                    if (selected === 'All' || row.getAttribute('data-type') === selected) {
                        row.classList.remove('d-none');
                    } else {
                        row.classList.add('d-none');
                    }
                });
            });
        });
    </script>
}
